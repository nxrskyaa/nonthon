# Nonthon environment template — copy to .env.local, never commit real values.
#
# AUTH_SECRET: 64-char random hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ACCESS_HASHES: comma-separated SHA-256(AUTH_SECRET + password) values.
# Generate with tools/hash-password.mjs — plaintext passwords are never stored here.
ACCESS_HASHES=
